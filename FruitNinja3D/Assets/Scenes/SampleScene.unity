  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "H\u01AF\u1EDANG D\u1EAAN C\xC1CH CH\u01A0I GAME\n- M\u1EE5c ti\xEAu tr\xF2 ch\u01A1i: Ch\xE9m c\xE0ng nhi\u1EC1u hoa qu\u1EA3 xu\u1EA5t hi\u1EC7n tr\xEAn m\xE0n h\xECnh c\xE0ng t\u1ED1t \u0111\u1EC3 ghi \u0111i\u1EC3m cao nh\u1EA5t, \u0111\u1ED3ng th\u1EDDi tr\xE1nh ch\xE9m ph\u1EA3i bom v\xE0 kh\xF4ng \u0111\u1EC3 l\u1ECDt l\u01B0\u1EDBi qu\u1EA3 n\xE0o.\n- Thao t\xE1c \u0111i\u1EC1u khi\u1EC3n:\nCh\u1EA1m v\xE0 vu\u1ED1t ng\xF3n tay (ho\u1EB7c chu\u1ED9t) tr\xEAn m\xE0n h\xECnh \u0111\u1EC3 t\u1EA1o \u0111\u01B0\u1EDDng ch\xE9m (Blade) c\u1EAFt \u0111\xF4i hoa qu\u1EA3.\n- T\u1EA1o chu\u1ED7i ch\xE9m li\xEAn t\u1EE5c t\u1EEB 3 qu\u1EA3 tr\u1EDF l\xEAn trong m\u1ED9t l\u1EA7n vu\u1ED1t \u0111\u1EC3 k\xEDch ho\u1EA1t hi\u1EC7u \u1EE9ng Combo nh\u1EADn th\xEAm \u0111i\u1EC3m th\u01B0\u1EDFng.\nH\u1EC7 th\u1ED1ng \u0111i\u1EC3m s\u1ED1:\n- M\u1ED7i lo\u1EA1i hoa qu\u1EA3 kh\xE1c nhau s\u1EBD mang l\u1EA1i s\u1ED1 \u0111i\u1EC3m th\u01B0\u1EDFng t\u01B0\u01A1ng \u1EE9ng khi b\u1ECB ch\xE9m tr\xFAng.\n- Ch\xE9m th\xE0nh c\xF4ng nhi\u1EC1u qu\u1EA3 li\xEAn ti\u1EBFp gi\xFAp t\u0103ng \u0111i\u1EC3m s\u1ED1 t\xEDch l\u0169y cho b\u1EA3ng x\u1EBFp h\u1EA1ng (High Score).\n- Quy \u0111\u1ECBnh v\u1EC1 M\u1EA1ng s\u1ED1ng (Lives):\n- Ng\u01B0\u1EDDi ch\u01A1i c\xF3 t\u1ED5ng c\u1ED9ng 3 m\u1EA1ng kh\u1EDFi \u0111\u1EA7u.\n- M\u1EA1ng s\u1EBD b\u1ECB tr\u1EEB \u0111i n\u1EBFu ng\u01B0\u1EDDi ch\u01A1i ch\xE9m nh\u1EA7m v\xE0o bom ho\u1EB7c \u0111\u1EC3 s\xF3t/b\u1ECF l\u1EE1 hoa qu\u1EA3 r\u01A1i qua m\xE0n h\xECnh m\xE0 kh\xF4ng ch\xE9m.\nTr\xF2 ch\u01A1i k\u1EBFt th\xFAc (Game Over) khi to\xE0n b\u1ED9 s\u1ED1 m\u1EA1ng b\u1ECB m\u1EA5t h\u1EBFt."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
